# Copy to repo root as `.bridge.env` and customize (do not commit secrets).
# Loaded automatically by scripts/run-ios-bridge.sh

Z3CLI_BRIDGE_TOKEN=change-me-to-a-long-random-string
Z3CLI_BRIDGE_HOST=0.0.0.0
Z3CLI_BRIDGE_PORT=8765

# Everything after -- is passed to `python -m z3cli --serve`
Z3CLI_BRIDGE_SERVE_EXTRA="--workspace $HOME/src/hobby/oracle-of-secrets"
